# 类型：feat/fix/docs/style/refactor/test/chore
# 格式：type(scope): description
#
# 示例：
# feat(game): add new card effect
# fix(ui): resolve layout issue on mobile
# docs(readme): update installation guide
#
# ========================================
# 提交前检查清单（必须逐项确认）
# ========================================
#
# [ ] 已运行 pre_commit_check.bat
# [ ] 构建成功 (npm run build)
# [ ] 测试通过 (npm test)
# [ ] dist 目录存在且完整
# [ ] 本地预览测试通过 (npm run preview)
# [ ] 无控制台错误
# [ ] 无敏感文件 (.env 等)
#
# ========================================

<type>(<scope>): <description>



# 详细说明（可选）



# 关联 Issue（可选）
# Closes #123
