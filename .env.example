# ============================================================================
# Magic Solitaire Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# AI Services
# ----------------------------------------------------------------------------

# 智谱 AI (Art Generation)
# Get from: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here

# ----------------------------------------------------------------------------
# Vercel (Hosting & Deployment)
# ----------------------------------------------------------------------------

# Vercel Token
# Get from: https://vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_token_here

# Vercel Organization ID
# Get from: https://vercel.com/dashboard
VERCEL_ORG_ID=your_vercel_org_id_here

# Vercel Project ID
# Get from: https://vercel.com/dashboard (click on project)
VERCEL_PROJECT_ID=your_vercel_project_id_here

# ----------------------------------------------------------------------------
# Google Services
# ----------------------------------------------------------------------------

# Google Analytics 4 Measurement ID
# Get from: https://analytics.google.com/
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense Client ID
# Get from: https://adsense.google.com/
ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# ----------------------------------------------------------------------------
# Game Configuration (Optional)
# ----------------------------------------------------------------------------

# Game version
VITE_GAME_VERSION=0.1.0

# Debug mode (true/false)
VITE_DEBUG_MODE=false

# ----------------------------------------------------------------------------
# API Endpoints (if needed later)
# ----------------------------------------------------------------------------

# Backend API URL (for future features)
VITE_API_URL=https://api.example.com

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
# - Never commit .env file to Git (it's in .gitignore)
# - Use .env.example as a template
# - Store production secrets in Vercel dashboard
# - For local development, use .env.local for overrides
